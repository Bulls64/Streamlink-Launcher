# Mesure de couverture des tests (CI : job « Test coverage »)
# Test coverage measurement (CI: "Test coverage" job)
[run]
source = launcher
branch = true

[report]
precision = 0
# Seuil sous lequel la CI échoue (mesure du 8 novembre 2026 : 61 %)
# Threshold below which the CI fails (measured on 8 November 2026: 61%)
fail_under = 56
