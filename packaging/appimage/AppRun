#!/bin/sh
# Point d'entrée de l'AppImage : Python embarqué (python-build-standalone) + le lanceur.
# -E : ignore PYTHONPATH/PYTHONHOME de l'utilisateur ; -s : ignore son site-packages.
# Rien n'est ajouté à l'environnement : Streamlink et le lecteur, lancés par l'application,
# utilisent ceux du système, sans interférence avec le Python embarqué.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/python/bin/python3" -E -s "$HERE/usr/share/streamlink-launcher/slink_launcher.py" "$@"
